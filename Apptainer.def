Bootstrap: docker
From: python:3.11-slim-bookworm

%labels
    Author Michael Perkinson
    Description AnimalTA video tracking for Open OnDemand
    Upstream https://github.com/VioletteChiara/AnimalTA
    Version 3.2.2-linux

%post
    apt-get update && apt-get install -y --no-install-recommends \
        python3-tk \
        libgl1-mesa-glx \
        libglib2.0-0 \
        libsm6 \
        libxext6 \
        libxrender1 \
        libfontconfig1 \
        ffmpeg \
        fonts-dejavu-core \
        libmediainfo0v5 \
        gnupg2 \
        curl \
        && rm -rf /var/lib/apt/lists/*

    curl -fsSL https://developer.download.nvidia.com/compute/cuda/repos/debian12/x86_64/cuda-keyring_1.1-1_all.deb \
        -o /tmp/cuda-keyring.deb \
        && dpkg -i /tmp/cuda-keyring.deb \
        && rm /tmp/cuda-keyring.deb \
        && apt-get update \
        && apt-get install -y --no-install-recommends cuda-nvrtc-12-6 \
        && rm -rf /var/lib/apt/lists/*

    pip install --no-cache-dir \
        opencv-python-headless>=4.8.0 \
        Pillow>=10.0.0 \
        numpy>=1.24.0 \
        scipy>=1.10.0 \
        scikit-learn>=1.3.0 \
        scikit-image>=0.21.0 \
        pandas>=2.0.0 \
        matplotlib>=3.7.0 \
        decord>=0.6.0 \
        h5py>=3.9.0 \
        pymediainfo>=6.0.0 \
        pandastable>=0.13.0 \
        psutil>=5.9.0 \
        pymsgbox>=1.0.9 \
        tksheet>=7.0.0 \
        cupy-cuda12x>=13.0.0

    mkdir -p /opt/animalta

%files
    . /opt/animalta

%environment
    export ANIMALTA_DISABLE_UPDATE=1
    export ANIMALTA_STARTUP_DEBUG=1
    export MPLBACKEND=TkAgg
    # cuda-nvrtc-12-6 installs to a non-standard path that CuPy's pathfinder does not search.
    # To verify the path inside a built .sif: apptainer exec <img>.sif find /usr -name "libnvrtc*"
    # If upgrading CUDA, update this path to match the new version.
    export LD_LIBRARY_PATH=/usr/local/cuda-12.6/targets/x86_64-linux/lib:${LD_LIBRARY_PATH}
    # Ensure tkinter finds the X display provided by the VNC session
    # DISPLAY is set by the OOD script at runtime

%runscript
    cd /opt/animalta
    exec python3 main.py "$@"
